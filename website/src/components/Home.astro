import Site from '../layouts/Site.astro';
import { links, localized } from '../copy/links';
import type { Copy } from '../copy/types';

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const l = copy.locale;
const downloads = `/${l}/downloads/`;

---

<Site copy={copy} page="home" title={copy.siteName} description={copy.positioning}>
  <header class="hero">
    <h1 class="display">{copy.hero.headline[0]}<b>{copy.hero.headline[1]}</b>{copy.hero.headline[2]}</h1>
    <p class="lede">{copy.hero.lede}</p>
    <div class="cta">
      <a class="btn primary" href={links.cli}>{copy.hero.nightly} <span class="arr">→</span></a>
      <a class="btn secondary" href={`${downloads}#source`}>{copy.hero.source}</a>
    </div>
    <div class="fine">{copy.hero.fine} · <a href={localized.architecture[l]}>{copy.hero.architecture}</a></div>

    <div class="scene" aria-hidden="true">
      <div class="turn">
        <div class="rail"></div>
        <div class="hwline" style="--i: 5"><span>{copy.scene.highWater}</span></div>
        {copy.scene.events.map((event, index) => (
          <div class:list={['ev-pill', event.tone]} style={`--i: ${index}`}><b>{event.label}</b><small>{event.detail}</small></div>
        ))}
      </div>
      <div class="tape-cap"><span>{copy.scene.caption}</span><span class="hw">{copy.scene.formula}</span></div>
    </div>
  </header>

  <section class="sec">
    <div class="sec-h">
      <h2>{copy.features.h2}</h2>
      <p>{copy.features.p}</p>
    </div>
    <div class="bento">
      <div class="tile c5 plain">
        <h3>{copy.host.h3}</h3>
        <p>{copy.host.p}</p>
        <a class="more" href={localized.architecture[l]}>{copy.host.more}</a>
        <div class="fig host">
          <div class="col">{copy.host.clients.map((client) => <span class="chip">{client}</span>)}</div>
          <div class="lines">→</div>
          <div class="core">{copy.host.core}<small>{copy.host.coreSmall}</small></div>
        </div>
      </div>
      <div class="tile c7">
        <h3>{copy.log.h3}</h3>
        <p>{copy.log.p}</p>
        <a class="more" href={links.eventLog}>{copy.log.more}</a>
        <div class="fig evs">
          {copy.scene.events.map((event, index) => (
            <span class:list={['e', event.tone.replace('dim', '').trim()]} style={`--i: ${index}`}>{event.name}</span>
          ))}
          <span class="cur" style={`--i: ${copy.scene.events.length}`}></span>
        </div>
      </div>
      <div class="tile c12 plain get">
        <div class="get-h"><h3>{copy.get.h3}</h3><p>{copy.get.p}</p></div>
        <div class="paths3">
          <a class="path" href={links.cli}>
            <div><b>{copy.get.nightly.title}</b><span>{copy.get.nightly.body}</span></div>
            <span class="note">{copy.get.nightly.note}</span>
          </a>
          <a class="path" href={`${downloads}#source`}>
            <div><b>{copy.get.source.title}</b><span>{copy.get.source.body}</span></div>
            <span class="note mut">{copy.get.source.note}</span>
          </a>
          <a class="path" href={`${downloads}#apache-releases`}>
            <div><b>{copy.get.releases.title}</b><span>{copy.get.releases.body}</span></div>
            <span class="note mut">{copy.get.releases.note}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // The hero scene and the log tile append their events one by one the first time they are seen.
    (() => {
      for (const el of document.querySelectorAll('.turn, .evs')) {
        el.classList.add('armed');
        new IntersectionObserver((entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          el.classList.add('play');
          observer.disconnect();
        }, { threshold: 0.4 }).observe(el);
      }
    })();
  </script>
</Site>
