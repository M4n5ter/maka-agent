    "../../crates/runtime-host/tests/fixtures/http-plugin.mjs",
    "../../crates/runtime-host/tests/fixtures/files-plugin.mjs",
    "../../crates/runtime-host/tests/fixtures/clients-plugin.mjs",
    "../../crates/runtime-host/tests/fixtures/remote-plugin.mjs",
    "../../crates/cli/tests/fixtures/board-plugin/host.mjs",
    "../../crates/cli/tests/fixtures/executor-plugin.mjs"
  ]
}
