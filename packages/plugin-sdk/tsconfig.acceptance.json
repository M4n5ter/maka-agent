{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "incremental": false,
    "paths": {
      "@maka-agent/plugin-sdk/host": ["./src/host.ts"]
